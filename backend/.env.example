# NestJS Server Port
PORT=4000

# PostgreSQL Connection String (Supabase / Render / Local Postgres)
# Note for Supabase: The default database name at the end of the URL is /postgres (NOT /job_queue)
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Environment Mode
NODE_ENV=development
